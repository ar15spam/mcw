# ---------------------------------------------------------------------------
# MIDICOLLAB web (Next.js) environment
# Copy to .env.local for local dev; set the same keys in Vercel for production.
# ---------------------------------------------------------------------------

# Rust realtime backend (Railway). Use https:// and wss:// in production.
NEXT_PUBLIC_API_URL=https://your-studio-backend.up.railway.app
NEXT_PUBLIC_WS_URL=wss://your-studio-backend.up.railway.app/ws

# Neon Postgres (pooled connection string).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
# Local: http://localhost:3000  ·  Production: your deployed https origin
BETTER_AUTH_URL=http://localhost:3000

# Shared HMAC secret between this app and the Rust realtime backend.
# MUST be byte-for-byte identical here and in the Railway service.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REALTIME_SHARED_SECRET=replace-with-a-strong-random-secret

# ---- Optional: Google OAuth --------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true
